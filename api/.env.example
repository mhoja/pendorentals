# Copy to api/.env for local development. Never commit real values.
PORT=5001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pendorentals
DB_USER=
DB_PASSWORD=
DB_SSL=false

# First admin account (created on first start if no admin exists)
STAFF_PHONE=0622882278
STAFF_NAME=Pendo Mbolela
STAFF_PASSWORD=

# Beem Africa SMS (leave empty to disable sending)
# eHub SMS (https://sms.ehub.co.tz → Developer → API Keys). EHUB_SENDER_ID is the approved
# sender ID's UUID or its name, e.g. Pendorentals.
EHUB_API_KEY=
EHUB_API_SECRET=
EHUB_SENDER_ID=
# Beem Africa is only used when the eHub keys above are empty.
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=

PUBLIC_URL=http://localhost:5173
